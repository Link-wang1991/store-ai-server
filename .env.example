# Copy these variables into your deployment environment or a local ignored .env file.
# Never commit real database passwords, JWT signing keys, or AI provider keys.
#
# 说明：标 ⚠️ 的为敏感凭据，未在 K8s Secret 中注入会导致对应功能直接不可用。

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://127.0.0.1:3306/store-ai?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=
DB_PASSWORD=              # ⚠️ 数据库密码

JWT_SECRET=               # ⚠️ JWT 签名密钥，至少 256 bit

AI_PROVIDER=mock
DEEPSEEK_API_KEY=         # ⚠️ 聊天与分析
QWEN_API_KEY=             # ⚠️ 语音转写（ASR）

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads/meeting-audio
STORAGE_KNOWLEDGE_LOCAL_PATH=./uploads/knowledge

# ---- 微信小程序登录 ----
# appid 为公开信息（application.yml 已带默认值），可不配
WX_APPID=
WX_SECRET=                # ⚠️ 小程序 secret

# ---- 阿里云短信（SMS_MODE=aliyun 时必填）----
SMS_MODE=mock
ALIYUN_SMS_ACCESS_KEY_ID=      # ⚠️
ALIYUN_SMS_ACCESS_KEY_SECRET=  # ⚠️
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=      # ⚠️ 通用验证码模板
ALIYUN_SMS_TEMPLATE_LOGIN=     # 可选，留空则用通用模板
ALIYUN_SMS_TEMPLATE_RESET=     # 可选，留空则用通用模板
